---
import type { CollectionEntry } from 'astro:content';
import { formatDate, slugifyTag } from '../utils';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<ul class="posts">
  {
    posts.map((post) => (
      <li>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <div>
          <a href={`/blog/${post.id}`} class="title">
            {post.data.title}
            {post.data.draft && <span class="pill">draft</span>}
          </a>
          <div class="tags">
            {post.data.tags.map((t) => (
              <a href={`/tags/${slugifyTag(t)}`} class="tag">
                {t}
              </a>
            ))}
          </div>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px dashed var(--border);
  }
  time {
    font-family: var(--mono);
    color: var(--faint);
    font-size: 0.85rem;
    padding-top: 0.1rem;
  }
  .title {
    color: var(--text);
    font-weight: 700;
  }
  .title:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .tags {
    margin-top: 0.1rem;
  }
  .tags .tag:hover {
    text-decoration: none;
    color: var(--accent);
  }
  @media (max-width: 520px) {
    li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
