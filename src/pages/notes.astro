---
import Base from '../layouts/Base.astro';
import Note from '../components/Note.astro';
import { SITE } from '../site.config';
import { getNotes } from '../utils';

const notes = await getNotes();
---

<Base title="Notes" description="A running log of small things I've learned in security and engineering.">
  <h1>Learning log</h1>
  <p class="muted">
    Small things I've learned, written down so I don't forget them. Shorter and messier than the blog.
  </p>
  <p class="now">
    <span>Currently learning:</span>
    {SITE.nowLearning.map((item) => <span class="pill">{item}</span>)}
  </p>
  <div class="spacer"></div>
  {notes.length ? notes.map((note) => <Note note={note} />) : <p class="muted">First entries coming soon.</p>}
</Base>

<style>
  .now {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
  }
  .spacer {
    height: 2rem;
  }
  .now > span:first-child {
    color: var(--amber);
    margin-right: 0.2rem;
  }
</style>
